---
// Pas de réseaux pro à afficher (confirmé par Nicolas, §12 du brief).
// Formulaire branché sur Web3Forms (voir .env.example) : il faut une clé
// d'accès gratuite créée sur https://web3forms.com avant que l'envoi
// fonctionne réellement.
---

<section id="contact" class="px-6 py-24 sm:px-10 lg:px-16">
	<div data-reveal class="mx-auto w-full max-w-3xl">
		<h2 class="text-3xl font-black tracking-tight sm:text-5xl">Parlons-en</h2>
		<p class="mt-4 text-ink/70">
			Un message, un appel, comme vous préférez. Basé à Toulouse,
			disponible partout en France à distance.
		</p>

		<div class="mt-8 flex flex-wrap items-center gap-4">
			<button
				type="button"
				id="copy-email"
				data-email="contact@nicolasgurak.fr"
				class="inline-flex items-center gap-2 rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold transition-colors hover:border-accent"
			>
				<span id="copy-email-label">Copier l'email</span>
			</button>
		</div>

		<form id="contact-form" class="mt-12 grid gap-6">
			<div class="grid gap-2">
				<label for="nom" class="text-sm font-semibold">Nom</label>
				<input
					type="text"
					id="nom"
					name="nom"
					required
					class="rounded-lg border border-ink/20 px-4 py-3 outline-none focus:border-accent"
				/>
			</div>
			<div class="grid gap-2">
				<label for="email" class="text-sm font-semibold">Email</label>
				<input
					type="email"
					id="email"
					name="email"
					required
					class="rounded-lg border border-ink/20 px-4 py-3 outline-none focus:border-accent"
				/>
			</div>
			<div class="grid gap-2">
				<label for="message" class="text-sm font-semibold">Message</label>
				<textarea
					id="message"
					name="message"
					rows="4"
					required
					class="rounded-lg border border-ink/20 px-4 py-3 outline-none focus:border-accent"
				></textarea>
			</div>

			<!-- Piège à bots : champ invisible pour un humain, rempli automatiquement par les scripts de spam. -->
			<input
				type="text"
				name="botcheck"
				tabindex="-1"
				autocomplete="off"
				aria-hidden="true"
				class="absolute left-[-9999px]"
			/>

			<button
				type="submit"
				class="justify-self-start rounded-full bg-gradient-to-r from-accent to-accent-purple px-8 py-4 text-base font-semibold text-white transition-[filter] hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60"
			>
				Envoyer
			</button>
			<p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<script>
	const button = document.getElementById("copy-email");
	const label = document.getElementById("copy-email-label");

	button?.addEventListener("click", async () => {
		const email = button.getAttribute("data-email") ?? "";
		try {
			await navigator.clipboard.writeText(email);
			if (label) label.textContent = "Copié !";
			setTimeout(() => {
				if (label) label.textContent = "Copier l'email";
			}, 2000);
		} catch {
			// Presse-papiers indisponible : rien à faire ici, l'utilisateur peut sélectionner le texte.
		}
	});

	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const status = document.getElementById("contact-status");
	const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!status) return;

		const submitButton = form.querySelector("button[type='submit']");
		const formData = new FormData(form);

		// Piège à bots : si le champ caché est rempli, on fait semblant que
		// l'envoi a réussi sans rien envoyer réellement.
		if (formData.get("botcheck")) {
			form.reset();
			status.textContent = "Message envoyé, merci !";
			status.className = "text-sm text-accent";
			return;
		}

		if (!accessKey) {
			status.textContent =
				"Le service d'envoi n'est pas encore configuré (TODO : clé Web3Forms manquante, voir .env.example).";
			status.className = "text-sm text-red-600";
			return;
		}

		formData.append("access_key", accessKey);
		submitButton?.setAttribute("disabled", "true");
		status.textContent = "Envoi en cours...";
		status.className = "text-sm text-ink/60";

		try {
			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { Accept: "application/json" },
				body: formData,
			});
			const result = await response.json();

			if (result.success) {
				form.reset();
				status.textContent =
					"Message envoyé, merci ! Je reviens vers vous rapidement.";
				status.className = "text-sm text-accent";
			} else {
				throw new Error(result.message ?? "Échec de l'envoi.");
			}
		} catch {
			status.textContent =
				"Une erreur est survenue, merci de réessayer ou d'écrire directement par email.";
			status.className = "text-sm text-red-600";
		} finally {
			submitButton?.removeAttribute("disabled");
		}
	});
</script>
