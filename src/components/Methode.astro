---
const etapes = [
	{ numero: "01", titre: "Échange", texte: "On parle de votre activité et de ce dont vous avez vraiment besoin." },
	{ numero: "02", titre: "Maquette", texte: "Vous voyez à quoi ressemblera votre site avant qu'il ne soit codé." },
	{ numero: "03", titre: "Développement", texte: "Je construis le site, rapide et propre, sur-mesure." },
	{ numero: "04", titre: "Mise en ligne", texte: "Votre site est publié, référencé, et prêt à convertir." },
];
---

<section id="methode" class="px-6 py-24 sm:px-10 lg:px-16">
	<div class="mx-auto w-full max-w-5xl">
		<h2 class="text-3xl font-black tracking-tight sm:text-5xl">Comment ça se passe</h2>
		<ol class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{
				etapes.map((etape) => (
					<li data-reveal>
						<span class="text-sm font-bold text-accent">{etape.numero}</span>
						<h3 class="mt-2 text-lg font-bold">{etape.titre}</h3>
						<p class="mt-2 text-sm text-ink/70">{etape.texte}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
