---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
	title="Page introuvable - Nicolas Gurak"
	description="Cette page n'existe pas ou plus."
>
	<Header />
	<main
		class="flex min-h-[80svh] flex-col items-center justify-center px-6 text-center sm:px-10"
	>
		<p class="text-sm font-bold uppercase tracking-wide text-accent">
			Erreur 404
		</p>
		<h1 class="mt-4 text-4xl font-black tracking-tight sm:text-6xl">
			Cette page n'a pas donné envie d'appeler.
		</h1>
		<p class="mt-6 max-w-md text-ink/70">
			Elle n'existe pas, ou plus. Retournez à l'accueil, tout le reste y est.
		</p>
		<a
			href="/"
			class="mt-10 inline-flex items-center justify-center rounded-full bg-gradient-to-r from-accent to-accent-purple px-8 py-4 text-base font-semibold text-white transition-[filter] hover:brightness-110"
		>
			Retour à l'accueil
		</a>
	</main>
</Layout>
